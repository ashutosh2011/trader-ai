# Copy to .env on the VM and fill in values. Never commit .env.
#
# --- deployment (non-secret) ---
DEPLOY_DOMAIN=tradebot.example.com
IMAGE=ghcr.io/OWNER/REPO:main
TZ=Asia/Kolkata
# App containers run as this host UID/GID so bind-mounted DuckDB/config files
# remain writable. The deploy workflow sets these automatically.
APP_UID=1000
APP_GID=1000

# Caddy basic auth (hash only — not the plaintext password)
BASIC_AUTH_USER=admin
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=

# --- runtime paths (relative to /app working directory) ---
KILL_SWITCH=0

# --- Kite (required for historical data + live) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- LLM providers ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
