# Copy to .env and fill in secrets (never commit .env)

# Kill switch: create ./KILL file or set KILL_SWITCH=1
KILL_SWITCH=0

# LLM providers (optional — default mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Zerodha Kite Connect (required for live)
KITE_API_KEY=
KITE_API_SECRET=
# Empty until login — expires at end of each trading day (re-run kite-login daily)
KITE_ACCESS_TOKEN=
# Obtain token: uv run python -m orchestrator.main kite-login
# Or pass --request-token after browser redirect
